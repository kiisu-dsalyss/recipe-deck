# Absolute path to spark-vllm-docker checkout (contains run-recipe.py and recipes/).
# Repo: https://github.com/eugr/spark-vllm-docker
SPARK_VLLM_ROOT=/path/to/spark-vllm-docker

# --- Optional path overrides (same file as HF_TOKEN: $SPARK_VLLM_ROOT/.env after first load) ---
# Defaults match a normal spark-vllm-docker layout; set only if your tree differs.
# RECIPE_DECK_RECIPES_DIR=/path/to/spark-vllm-docker/recipes
# RECIPE_DECK_TEMP_DIR=/path/to/spark-vllm-docker/.recipe-deck-tmp
# RUN_RECIPE_PY=/path/to/spark-vllm-docker/run-recipe.py
# RUN_RECIPE_SH=/path/to/spark-vllm-docker/run-recipe.sh

# Optional: systemd user unit name for POST /api/service/restart (default recipe-deck.service).
# RECIPE_DECK_SYSTEMD_UNIT=recipe-deck.service

# HTTP bind (default 0.0.0.0 — reachable on LAN). Use 127.0.0.1 for loopback only + SSH tunnel.
# SWITCHER_HOST=127.0.0.1

# HTTP port (default 3000).
SWITCHER_PORT=3000

# vLLM listen port (must not collide with SWITCHER_PORT).
VLLM_PORT=8000

# Python interpreter for run-recipe.py.
PYTHON=python3

# Regex matched against combined stdout/stderr to mark a slot HEALTHY (after BOOTING).
READY_REGEX=Uvicorn running|Application startup complete

# Ring buffer caps for streamed logs (UI + WS).
MAX_LOG_LINES=4000
MAX_LOG_BYTES=2000000

# Polling intervals (milliseconds).
DISK_STATS_INTERVAL_MS=45000
GPU_STATS_INTERVAL_MS=10000
VLLM_METRICS_INTERVAL_MS=5000

# HF hub cache dir for `Model In Cache` progress (default ~/.cache/huggingface/hub or $HF_HOME/hub).
# HF_HUB_CACHE=/home/your-user/.cache/huggingface/hub
#
# Optional cold HF archive (contains hub/). Off unless you enable it in Settings
# or set both keys. Do not set HF_HOME to the archive — serve stays on NVMe.
# HF_ARCHIVE_ENABLED=false
# HF_ARCHIVE_DIR=/mnt/archive/hf-archive

# How often to compare on-disk hub folder size vs Hugging Face API while a slot is BOOTING (default 2000).
# MODEL_CACHE_POLL_MS=2000

# Rolling per-slot log files on disk (same lines as UI). Override if ~/.local is undesirable.
# LOG_DIR=/home/your-user/.local/share/recipe-deck/logs
LOG_MAX_FILE_MB=32
LOG_MAX_FILES=8

# Boot watchdog: max time waiting for READY_REGEX before ERROR (default 10 minutes).
HEALTH_PROBE_TIMEOUT_MS=600000

# Grace period after SIGTERM before SIGKILL when stopping a slot.
BOOT_SIGTERM_GRACE_MS=15000

# Set true only if you need run-recipe.sh to bootstrap PyYAML on an unusual host.
# RUN_RECIPE_USE_SHELL_WRAPPER=false

# Sidekick: Recipe Deck tries `docker tag vllm-node-tf5 vllm-sidekick` by default (optional; logs a warning if
# the base image is missing so the managed runner still starts). Override or extend with DOCKER_IMAGE_ALIASES, or disable:
# DISABLE_SIDEKICK_IMAGE_ALIAS=1
# Format: comma-separated TARGET=SOURCE → runs: docker tag SOURCE TARGET
# DOCKER_IMAGE_ALIASES=vllm-sidekick=vllm-custom-base

# --- Sparkrun cluster runner ---
# `sparkrun` binary used for sparkrun-cluster recipes (recipe_version 2 + runtime, or min_nodes > 1).
# Falls back to `sparkrun` on PATH; set explicitly if the binary lives outside PATH.
# SPARKRUN_BIN=/usr/local/bin/sparkrun
# Extra args prepended before `run <recipe.yaml>` / `stop <recipe.yaml>` (space-separated).
# SPARKRUN_EXTRA_ARGS=--project spark-cluster

# --- Cluster host metrics (CPU/GPU chips for all cluster nodes) ---
# Path to sparkrun config directory (default: ~/.config/sparkrun). Expand $HOME automatically.
# SPARKRUN_CONFIG_DIR=~/.config/sparkrun
# Explicit cluster name; if unset, read from $SPARKRUN_CONFIG_DIR/clusters/.default.
# SPARKRUN_CLUSTER=gx10-dual
# Set to false to disable per-host SSH metric sampling entirely.
# CLUSTER_METRICS_ENABLED=true
# SSH user for remote host sampling; overrides the `user:` field in the cluster YAML.
# CLUSTER_METRICS_SSH_USER=spark
# SSH connect timeout in ms (default 4000).
# CLUSTER_METRICS_SSH_TIMEOUT_MS=4000

# --- Crash auto-restart ---
# Cooldown before the runner relaunches after an unexpected exit (default 30s).
# Persisted per-recipe in `.current-recipe` via `AUTORESTART_CURRENT_RECIPE`.
# AUTORESTART_COOLDOWN_MS=30000
