{
  "name": "recipe-deck",
    "version": "0.2.40",
  "private": true,
  "license": "MIT",
  "description": "Operator UI for NVIDIA DGX Spark (GB10/GX10 family); requires eugr/spark-vllm-docker on-host (https://github.com/eugr/spark-vllm-docker).",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/main.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist/server/main.js",
    "start:prod": "node dist/server/main.js",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "check:lines": "bash ./scripts/check-line-limit.sh",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"types/**/*.ts\" \"shared/**/*.ts\"",
    "setup": "bash ./scripts/setup.sh",
    "demo:test": "npm --prefix demo run test",
    "demo:mov": "bash demo/scripts/encode-mov.sh"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.2.1"
  }
}
